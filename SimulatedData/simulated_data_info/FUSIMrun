cd /opt/fusim-0.2.2/

wget -O refFlat.txt.gz http://hgdownload.cse.ucsc.edu/goldenPath/hg38/database/refFlat.txt.gx
gunzip refFlat.txt.gz
wget ftp://hgdownload.cse.ucsc.edu/goldenPath/hg38/bigZips/hg38.chromFa.tar.gz
tar -xzf chromFa.tar.gz
cat chr*.fa > hg38.fa

samtools faidx hg38.fa

java -jar fusim.jar --convert -i gencode.v43.annotation.gtf --output gencode_v43_RefFlat.txt

java -jar fusim.jar \
	-g gencode_v43_RefFlat.txt -r hg38.fa \
	-j 100 -n 100 -s 100 -x 100 -y 100 \
	-o Jul23_benchmark_fusions.txt Jul23_benchmark_fusions.fasta #
# Figure output. Exploratory plots written by the analysis scripts are not tracked.
*.png
*.pdf
*.jpeg
*.jpg
*.svg
*.tiff

# The manuscript figures are the exception: vector SVG is tracked, the 600 dpi PNG
# preview is not, since it is regenerated from the same script.
!Figures/FigureFiles/output/**/*.svg

